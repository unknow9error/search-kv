MEKEN_ENV=demo
MEKEN_DATABASE_URL=sqlite+aiosqlite:///./meken.sqlite3
MEKEN_REDIS_URL=
MEKEN_AUTO_CREATE_SCHEMA=true
MEKEN_PROVIDER_CONFIG=data/providers.example.json
# AI is opt-in. Never ship these secrets in the iOS app.
MEKEN_AI_ENABLED=false
MEKEN_OPENAI_API_KEY=
MEKEN_AI_MODEL=gpt-4.1-mini
MEKEN_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
MEKEN_METRICS_TOKEN=
MEKEN_PRIVACY_URL=
MEKEN_TERMS_URL=

