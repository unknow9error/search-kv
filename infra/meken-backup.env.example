# Install as /opt/meken/shared/backup.env with owner root and mode 0600.
# These paths contain secrets/data and must never be committed.
MEKEN_BACKUP_ROOT=/opt/meken/backups
MEKEN_BACKUP_PROJECT=/opt/meken/current
MEKEN_BACKUP_COMPOSE_ENV=/opt/meken/shared/.env
MEKEN_BACKUP_DATABASE=meken
MEKEN_BACKUP_DB_USER=meken_admin

# REQUIRED: a dedicated offsite S3/S3-compatible bucket and prefix.
# Empty values deliberately fail before reading the database.
MEKEN_BACKUP_DESTINATION=
# Generate recipient/private key on a separate trusted computer using age-keygen.
# Only the public recipient belongs on the server. Keep the private key offsite.
MEKEN_BACKUP_AGE_RECIPIENT=
# Optional custom S3-compatible HTTPS endpoint. Never production's own host.
MEKEN_BACKUP_S3_ENDPOINT=
AWS_DEFAULT_REGION=
# Prefer an explicit AWS credentials file outside the release directory.
# If static credentials are used here, restrict them to the dedicated prefix.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

MEKEN_BACKUP_RETAIN_DAYS=30
MEKEN_BACKUP_TIMEOUT_SECONDS=900
MEKEN_BACKUP_RESTORE_MEMORY=768m
# Stop before source access when space is low or failed attempts accumulate.
MEKEN_BACKUP_MIN_FREE_MB=1024
MEKEN_BACKUP_MAX_PENDING=3
