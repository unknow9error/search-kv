server {
    listen 80;
    listen [::]:80;
    server_name __MEKEN_HOST__;
    access_log off;
    location /.well-known/acme-challenge/ {
        root /var/lib/meken-acme;
    }
    location / {
        return 308 https://__MEKEN_HOST__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __MEKEN_HOST__;
    ssl_certificate /etc/letsencrypt/live/__MEKEN_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__MEKEN_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 16k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    location = /privacy {
        alias /opt/meken/current/infra/public/privacy.html;
        default_type text/html;
    }
    location = /terms {
        alias /opt/meken/current/infra/public/terms.html;
        default_type text/html;
    }
    location ~ ^/(metrics|docs|redoc|openapi\.json|health)(/|$) {
        return 404;
    }
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
}
